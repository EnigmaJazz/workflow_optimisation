+# The Claude Agent provider runs the Claude Code binary inside the sandbox. Its state and login live in this dedicated folder (inside the
+# writable V2 data grant), never in ~/.claude, which the profile denies. Log in once, outside the sandbox:
+#   env CLAUDE_CONFIG_DIR=<this folder> claude auth login
+V2_CLAUDE_CONFIG_DIR="$V2_XDG_DATA_HOME/claude-config"
+mkdir -p "$CONTROL_DIR" "$V2_XDG_CONFIG_HOME" "$V2_XDG_DATA_HOME" "$V2_XDG_STATE_HOME" "$V2_XDG_CACHE_HOME" "$V2_XDG_DATA_HOME/tmp" "$V2_CLAUDE_CONFIG_DIR"
+chmod 700 "$CONTROL_DIR" "$V2_ROOT" "$V2_CLAUDE_CONFIG_DIR"
